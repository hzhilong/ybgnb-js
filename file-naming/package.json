{
  "name": "@ybgnb/file-naming",
  "version": "1.0.1",
  "author": "hzhilong",
  "private": false,
  "description": "文件命名模板解析器",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsc --build --noEmit && eslint .",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "barrelsby": "barrelsby -c barrelsby.json & import-suffixer \"src/**/*.ts\"",
    "build": "tsup",
    "npm login": "npm login",
    "npm publish": "npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hzhilong/ybgnb-js",
    "directory": "file-naming"
  },
  "keywords": [
    "ybgnb"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hzhilong/ybgnb-js/issues"
  },
  "homepage": "https://github.com/hzhilong/ybgnb-js/tree/main/file-naming#readme",
  "dependencies": {
    "@ybgnb/utils": "^0.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "barrelsby": "^2.8.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.0.1",
    "import-suffixer": "^0.0.1",
    "jiti": "^2.7.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  }
}
