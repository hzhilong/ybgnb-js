{
  "name": "@ybgnb/utils",
  "version": "0.1.7",
  "author": "hzhilong",
  "private": false,
  "description": "自用工具库",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.app.json --noEmit  && eslint .",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "barrelsby": "rimraf \"./src/index.ts\" && barrelsby -c barrelsby.json --noHeader --location top",
    "build": "vite build --mode library",
    "npm login": "npm login",
    "npm publish": "npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hzhilong/ybgnb-js",
    "directory": "utils"
  },
  "keywords": [
    "ybgnb"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hzhilong/ybgnb-js/issues"
  },
  "homepage": "https://github.com/hzhilong/ybgnb-js/tree/main/utils#readme",
  "devDependencies": {
    "barrelsby": "^2.8.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.8",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "dayjs": "^1.11.13"
  }
}
