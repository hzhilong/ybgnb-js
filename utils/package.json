{
  "name": "@ybgnb/utils",
  "version": "0.0.2",
  "author": "hzhilong",
  "private": false,
  "description": "自用工具库",
  "main": "dist/index.umd.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "类型检查": "tsc --noEmit",
    "代码检查": "eslint .",
    "build": "barrelsby -c barrelsby.json --delete --noHeader && vite build",
    "npm 登录": " npm login",
    "npm 发布": " npm publish --access public",
    "本地发布": "yalc publish",
    "本地构建并发布": "barrelsby -c barrelsby.json --delete --noHeader && vite build --mode library && yalc publish"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hzhilong/ybgnb-js",
    "directory": "utils"
  },
  "keywords": [
    "ybgnb"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hzhilong/ybgnb-js/issues"
  },
  "homepage": "https://github.com/hzhilong/ybgnb-js#readme",
  "devDependencies": {
    "barrelsby": "^2.8.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.43.0",
    "jiti": "^2.5.1",
    "vite": "^7.1.5",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "dayjs": "^1.11.13",
    "nanoid": "^5.1.5"
  }
}
