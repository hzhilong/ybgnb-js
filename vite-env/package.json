{
  "name": "@ybgnb/vite-env",
  "version": "0.0.4",
  "author": "hzhilong",
  "type": "module",
  "productName": "@ybgnb/vite-env",
  "productCNName": "@ybgnb/vite-env",
  "description": "自用 vite 环境变量初始化",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "init": "./dist/init.js"
  },
  "scripts": {
    "check": "tsc --build --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "build": "tsup",
    "npm login": "npm login",
    "npm publish": "npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hzhilong/ybgnb-js",
    "directory": "vite-env"
  },
  "keywords": [
    "ybgnb"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hzhilong/ybgnb-js/issues"
  },
  "homepage": "https://github.com/hzhilong/ybgnb-js#readme",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.0.1",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@npm/types": "^2.1.0"
  }
}
