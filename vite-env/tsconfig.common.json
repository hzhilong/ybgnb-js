{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext"
    ],
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "noEmit": true,
    "sourceMap": true
  },
  "include": [
    "src/common/**/*",
    "src/env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".yalc",
    "yalc.lock"
  ]
}
